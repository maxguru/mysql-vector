# https://editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# PHP source (PSR-12 style indentation)
[*.php]
indent_style = space
indent_size = 4

# JSON config (composer.json)
[*.json]
indent_style = space
indent_size = 2

# YAML (DDEV config)
[*.yaml]
indent_style = space
indent_size = 2

# Markdown: keep intentional trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false
