{
  "name": "maxguru/mysql-vector",
  "description": "Perform vector operations natively on MySQL",
  "type": "library",
  "license": "MIT",
  "version": "3.2.0",
  "authors": [
    {
      "name": "Alex R.",
      "email": "inquiries@maximum.guru",
      "homepage": "https://maximum.guru"
    },
    {
      "name": "Allan Pichardo",
      "email": "allan.pichardo@gmail.com",
      "homepage": "https://allanpichardo.com"
    },
    {
      "name": "Albert Skibinski",
      "email": "albert.skibinski@gmail.com",
      "homepage": "https://albert.skibinski.nl"
    }
  ],
  "require": {
    "php": ">=7.2",
    "ext-mysqli": "*",
    "ext-json": "*",
    "ext-ctype": "*"
  },

  "autoload": {
      "psr-4": {
        "MHz\\MysqlVector\\": "src/"
      }
  },
  "autoload-dev": {
      "psr-4": {
        "MHz\\MysqlVector\\Tests\\": "tests/"
      }
  },
  "require-dev": {
      "phpunit/phpunit": "^9.5",
      "bartlett/php-compatinfo": "^7.2"
  },
  "scripts": {
      "test": "phpunit tests",
      "compatinfo": [
        "mkdir -p vendor/.cache/php-compatinfo",
        "[ -f vendor/.cache/php-compatinfo/compatinfo-db.sqlite ] || DATABASE_URL=\"sqlite:///$(pwd)/vendor/.cache/php-compatinfo/compatinfo-db.sqlite\" php -d memory_limit=1024M vendor/bin/phpcompatinfo db:new",
        "DATABASE_URL=\"sqlite:///$(pwd)/vendor/.cache/php-compatinfo/compatinfo-db.sqlite\" vendor/bin/phpcompatinfo analyser:run src"
      ],
      "compatinfo:rebuild": [
        "mkdir -p vendor/.cache/php-compatinfo",
        "DATABASE_URL=\"sqlite:///$(pwd)/vendor/.cache/php-compatinfo/compatinfo-db.sqlite\" php -d memory_limit=1024M vendor/bin/phpcompatinfo db:new --force"
      ]
  },
  "archive": {
    "exclude": [
      "/tests",
      "/.ddev",
      "/.github",
      "/vendor",
      "/.editorconfig",
      "/.gitignore",
      "/.gitattributes",
      "/composer.lock"
    ]
  }
}
