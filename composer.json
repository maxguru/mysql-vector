{
  "name": "allanpichardo/mysql-vector",
  "description": "Perform vector operations natively on MySQL",
  "type": "library",
  "license": "MIT",
  "version": "2.0.4",
  "authors": [
    {
      "name": "Alex R.",
      "email": "inquiries@maximum.guru",
      "homepage": "https://maximum.guru"
    },
    {
      "name": "Allan Pichardo",
      "email": "allan.pichardo@gmail.com",
      "homepage": "https://allanpichardo.com"
    },
    {
      "name": "Albert Skibinski",
      "email": "albert.skibinski@gmail.com",
      "homepage": "https://albert.skibinski.nl"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-mysqli": "*"
  },

  "autoload": {
      "psr-4": {
        "MHz\\MysqlVector\\": "src/"
      }
  },
  "autoload-dev": {
      "psr-4": {
        "MHz\\MysqlVector\\Tests\\": "tests/"
      }
  },
  "require-dev": {
      "phpunit/phpunit": "^9.5"
  },
  "scripts": {
      "test": "phpunit tests"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/.ddev",
      "/vendor",
      "/.editorconfig",
      "/.gitignore",
      "/.gitattributes",
      "/composer.lock"
    ]
  }
}
